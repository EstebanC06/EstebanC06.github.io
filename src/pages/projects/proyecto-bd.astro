---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { proyectos } from '../../data/proyectos';

const translations = {
	back:    { en: '← Back to Evidences', es: '← Volver a Evidencias' },
	subtitle:{ en: 'Project',             es: 'Proyecto' },
	title:   { en: 'Final Project — Databases', es: 'Proyecto Final — Bases de Datos' },
	desc: {
		en: 'Final database project with full stack implementation.',
		es: 'Proyecto final de bases de datos con implementación full stack.',
	},
	details: { en: 'Details', es: 'Detalles' },
	repo:    { en: 'Repo',    es: 'Repo' },
	empty: {
		en: 'No projects yet. Coming soon.',
		es: 'Aún no hay proyectos. Próximamente.',
	},
};
---

<Layout title={`Proyecto BD | David Caicedo`}>
	<Header />

	<main class="min-h-screen px-4 sm:px-6 md:px-6">
		<article class="max-w-3xl mx-auto pt-24 sm:pt-32 md:pt-48 pb-16 sm:pb-24 fade-in">

			<a href="/projects"
				class="text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors mb-8 inline-block"
				data-en={translations.back.en} data-es={translations.back.es}>
				{translations.back.en}
			</a>

			<header class="mb-12">
				<p class="text-xs sm:text-sm font-medium text-gray-600 dark:text-gray-400 mb-3 tracking-wider uppercase"
					data-en={translations.subtitle.en} data-es={translations.subtitle.es}>
					{translations.subtitle.en}
				</p>
				<h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4"
					data-en={translations.title.en} data-es={translations.title.es}>
					{translations.title.en}
				</h1>
				<p class="text-lg text-gray-600 dark:text-gray-400"
					data-en={translations.desc.en} data-es={translations.desc.es}>
					{translations.desc.en}
				</p>
			</header>

			{proyectos.length === 0 ? (
				<div class="flex flex-col items-center justify-center py-24 text-center border border-dashed border-gray-300 dark:border-gray-700 rounded-2xl">
					<span class="text-4xl mb-4">🗄️</span>
					<p class="text-gray-500 dark:text-gray-400 text-sm"
						data-en={translations.empty.en} data-es={translations.empty.es}>
						{translations.empty.en}
					</p>
				</div>
			) : (
				<div class="space-y-4">
					{proyectos.map((proyecto) => (
						<div class="border border-gray-200 dark:border-gray-800 rounded-xl bg-gray-50 dark:bg-gray-900/50 p-4 sm:p-5">
							<div class="flex items-center justify-between gap-4">

								<div class="flex-1 min-w-0">
									<h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white locale-es">
										{proyecto.titleES}
									</h3>
									<h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-white locale-en">
										{proyecto.titleEN}
									</h3>
									<p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 locale-es">
										{proyecto.summaryES}
									</p>
									<p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 locale-en">
										{proyecto.summaryEN}
									</p>
								</div>

								<div class="flex items-center gap-2 shrink-0">

									<a href={`/projects/proyecto/${proyecto.slug}`}
										class="px-3 py-1.5 text-xs font-medium rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 hover:opacity-80 transition-all"
										data-en={translations.details.en} data-es={translations.details.es}>
										{translations.details.en}
									</a>

									{proyecto.repoURL && (
										<a href={proyecto.repoURL} target="_blank" rel="noopener noreferrer"
											class="px-3 py-1.5 text-xs font-medium rounded-full border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center gap-1"
											data-en={translations.repo.en} data-es={translations.repo.es}>
											{translations.repo.en}
											<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
													d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
											</svg>
										</a>
									)}

								</div>
							</div>
						</div>
					))}
				</div>
			)}

		</article>
	</main>

	<Footer />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			document.querySelector('.fade-in')?.classList.add('visible');
		});
	</script>
</Layout>

<style>
	@reference "../../styles/global.css";
</style>