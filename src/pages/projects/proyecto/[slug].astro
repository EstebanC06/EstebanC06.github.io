---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { proyectos } from '../../../data/proyectos';

export function getStaticPaths() {
	return proyectos.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const proyecto = proyectos.find((p) => p.slug === slug)!;

const translations = {
	back:         { en: '← Back to Project',  es: '← Volver al Proyecto' },
	technologies: { en: 'Technologies',        es: 'Tecnologías' },
	description:  { en: 'Description',         es: 'Descripción' },
	repo:         { en: 'Repository',          es: 'Repositorio' },
	gallery:      { en: 'Gallery',             es: 'Galería' },
	noImages: {
		en: 'Screenshots will be added when available.',
		es: 'Las capturas se agregarán cuando estén disponibles.',
	},
};
---

<Layout title={`${proyecto.titleES} | David Caicedo`}>
	<Header />

	<main class="min-h-screen px-4 sm:px-6 md:px-6">
		<article class="max-w-3xl mx-auto pt-24 sm:pt-32 md:pt-48 pb-16 sm:pb-24 fade-in">

			<a href="/projects/proyecto-bd"
				class="text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors mb-8 inline-block"
				data-en={translations.back.en} data-es={translations.back.es}>
				{translations.back.en}
			</a>

			{/* ── Título ── */}
			<header class="mb-12">
				<h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-3">
					{proyecto.titleES}
				</h1>
				<p class="text-base text-gray-500 dark:text-gray-400 locale-es">{proyecto.summaryES}</p>
				<p class="text-base text-gray-500 dark:text-gray-400 locale-en">{proyecto.summaryEN}</p>
			</header>

			<div class="space-y-12">

				{/* ── Descripción larga ── */}
				<section>
					<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4"
						data-en={translations.description.en} data-es={translations.description.es}>
						{translations.description.en}
					</h2>
					<p class="text-gray-600 dark:text-gray-400 leading-relaxed locale-es">
						{proyecto.descriptionES}
					</p>
					<p class="text-gray-600 dark:text-gray-400 leading-relaxed locale-en">
						{proyecto.descriptionEN}
					</p>
				</section>

				{/* ── Stack / Tecnologías ── */}
				<section>
					<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4"
						data-en={translations.technologies.en} data-es={translations.technologies.es}>
						{translations.technologies.en}
					</h2>
					<div class="flex flex-wrap gap-2">
						{proyecto.stack.map((tech) => (
							<span class="px-3 py-1 text-sm font-medium rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-transparent hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-300 cursor-default">
								{tech}
							</span>
						))}
					</div>
				</section>

				{/* ── Repositorio ── */}
				{proyecto.repoURL && (
					<section>
						<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4"
							data-en={translations.repo.en} data-es={translations.repo.es}>
							{translations.repo.en}
						</h2>
						<a href={proyecto.repoURL} target="_blank" rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-full border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
							{/* GitHub icon */}
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
							</svg>
							GitHub — EstebanC06/CocoTechSystems
							<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
									d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
							</svg>
						</a>
					</section>
				)}

				{/* ── Galería ── */}
				<section>
					<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-6"
						data-en={translations.gallery.en} data-es={translations.gallery.es}>
						{translations.gallery.en}
					</h2>

					{proyecto.images.length > 0 ? (
						<div class="grid grid-cols-1 gap-6">
							{proyecto.images.map((src, i) => (
								<div class="relative rounded-2xl overflow-hidden border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 group">
									<img
										src={src}
										alt={`${proyecto.titleES} — captura ${i + 1}`}
										class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.02]"
										loading="lazy"
									/>
								</div>
							))}
						</div>
					) : (
						<div class="flex flex-col items-center justify-center py-16 text-center border border-dashed border-gray-300 dark:border-gray-700 rounded-2xl">
							<span class="text-4xl mb-4">🖼️</span>
							<p class="text-gray-500 dark:text-gray-400 text-sm"
								data-en={translations.noImages.en} data-es={translations.noImages.es}>
								{translations.noImages.en}
							</p>
						</div>
					)}
				</section>

			</div>
		</article>
	</main>

	<Footer />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			document.querySelector('.fade-in')?.classList.add('visible');

			// Aplica idioma activo al cargar
			const lang = document.documentElement.getAttribute('data-lang') || 'es';
			document.querySelectorAll('[data-en]').forEach((el) => {
				(el as HTMLElement).textContent =
					lang === 'es'
						? (el.getAttribute('data-es') ?? '')
						: (el.getAttribute('data-en') ?? '');
			});
		});
	</script>
</Layout>

<style>
	@reference "../../../styles/global.css";
</style>
